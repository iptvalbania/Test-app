# Copy this file to .env and fill in your values
# Never commit .env to version control

# Google OAuth credentials
# Create a project at https://console.cloud.google.com/
# Enable the "Google+ API" or "Google Identity" service
# Create OAuth 2.0 credentials (Web application)
# Add http://localhost:3000/auth/google/callback as an Authorized redirect URI
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth callback URL (change for production)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Random string used to sign session cookies — use a long random value in production
SESSION_SECRET=change-me-to-a-long-random-string

# Server port (optional, defaults to 3000)
PORT=3000
